# Optional absolute directory outside this source tree for private local data.
# LEARNPILOT_DATA_DIR=/absolute/private/path
# Live AI remains disabled in the synthetic prototype.
# For LAN startup, export these in the terminal (the launcher does not load .env files).
# LEARNPILOT_LAN_INTERFACE=en0
# LEARNPILOT_LAN_PORT=3000
# LEARNPILOT_BACKEND_PORT=3100
